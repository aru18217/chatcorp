# Copy this file to .env and fill in your own values. Never commit .env.

# ---------- Backend (server.js) ----------
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chatcorp?retryWrites=true&w=majority

# 64 hex characters (32 bytes) used for AES-256 message encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Any long random string, used to sign login tokens
JWT_SECRET=

# Key for the locked meeting rooms (Room Meeting 1A/1B/1C)
ROOM_PASSWORD=

# Where the React app runs (for CORS)
CLIENT_URL=http://localhost:3000
PORT=5001

# EmailJS (OTP emails are sent by the server). Leave empty in development:
# the OTP is then printed in the server console instead.
# In EmailJS, enable: Account > Security > "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ---------- Frontend (React) ----------
REACT_APP_API_URL=http://localhost:5001
